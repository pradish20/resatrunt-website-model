# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Provide these if you want to connect your live Supabase PostgreSQL database,
# Auth, and Storage bucket ('restaurant-gallery').
# If left empty, the application runs seamlessly in local persistent mode with live reactive edits!
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
